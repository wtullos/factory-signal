---
import { canonical } from '../lib/content.js';

const {
  title = 'Factory Signal article',
  text = '',
  pathname = Astro.url.pathname,
  url = canonical(pathname),
  label = 'Share',
} = Astro.props;
const statusId = `share-status-${Math.random().toString(36).slice(2)}`;
---
<div class="share-control" data-share-root>
  <button
    class="share-button"
    type="button"
    data-share-button
    data-share-title={title}
    data-share-text={text}
    data-share-url={url}
    aria-label={`Share article: ${title}`}
    aria-describedby={statusId}
  >
    <span aria-hidden="true">↗</span>
    <span>{label}</span>
  </button>
  <span id={statusId} class="share-status" data-share-status aria-live="polite"></span>
</div>

<script is:inline>
  (() => {
    if (window.__factorySignalShareReady) return;
    window.__factorySignalShareReady = true;

    const resetDelay = 2200;

    async function copyToClipboard(value) {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value);
        return true;
      }

      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.top = '-9999px';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();

      try {
        return document.execCommand('copy');
      } finally {
        document.body.removeChild(textarea);
      }
    }

    function setStatus(root, message) {
      const status = root.querySelector('[data-share-status]');
      if (status) status.textContent = message;
    }

    function setButtonLabel(button, label) {
      const text = button.querySelector('span:last-child');
      if (text) text.textContent = label;
    }

    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-share-button]');
      if (!button) return;

      const root = button.closest('[data-share-root]');
      const title = button.dataset.shareTitle || document.title;
      const text = button.dataset.shareText || title;
      const url = button.dataset.shareUrl || window.location.href;
      const originalLabel = button.querySelector('span:last-child')?.textContent || 'Share';

      button.disabled = true;
      setStatus(root, '');

      try {
        if (navigator.share) {
          await navigator.share({ title, text, url });
          setButtonLabel(button, 'Shared');
          setStatus(root, 'Shared.');
        } else {
          const copied = await copyToClipboard(url);
          setButtonLabel(button, copied ? 'Copied' : 'Copy link');
          setStatus(root, copied ? 'Link copied.' : 'Copy failed. Select the address bar to copy this link.');
        }
      } catch (error) {
        if (error?.name === 'AbortError') {
          setStatus(root, '');
        } else {
          try {
            const copied = await copyToClipboard(url);
            setButtonLabel(button, copied ? 'Copied' : 'Copy link');
            setStatus(root, copied ? 'Link copied.' : 'Copy failed. Select the address bar to copy this link.');
          } catch {
            setButtonLabel(button, 'Copy link');
            setStatus(root, 'Copy failed. Select the address bar to copy this link.');
          }
        }
      } finally {
        window.setTimeout(() => {
          setButtonLabel(button, originalLabel);
          setStatus(root, '');
          button.disabled = false;
        }, resetDelay);
      }
    });
  })();
</script>
