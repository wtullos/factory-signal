---
import { isAcceptableSourceImage } from '../lib/image-rules.js';

const { item, compact = false, variant = '' } = Astro.props;
const stats = [item.views, item.duration, item.scoreCount ? `Score ${item.scoreCount}` : null, item.comments ? `${item.comments} comments` : null].filter(Boolean).join(' · ');

const placeholderSeed = [item.topic, item.source, item.title].filter(Boolean).join('|') || 'Factory Signal';
const palette = [
  ['#262a2e', '#39a935', '#e8f6e6'],
  ['#1f2f24', '#49c743', '#f0f9ee'],
  ['#30363a', '#39a935', '#dff4dc'],
  ['#17351d', '#7ed957', '#ecf9e9'],
  ['#202428', '#8bd17c', '#f4fbf2'],
  ['#2b302d', '#2f9d34', '#e4f5e1'],
];

function hashString(value) {
  let hash = 2166136261;
  for (let index = 0; index < value.length; index += 1) {
    hash ^= value.charCodeAt(index);
    hash = Math.imul(hash, 16777619);
  }
  return hash >>> 0;
}

function labelFrom(item) {
  const label = item.topic || item.source || 'Factory Signal';
  return label
    .replace(/[^a-z0-9&/ ]/gi, ' ')
    .split(/[\s/&]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0].toUpperCase())
    .join('') || 'FS';
}

function truncateExcerpt(value, maxLength = compact ? 150 : 190) {
  if (typeof value !== 'string') return '';

  const normalized = value.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLength) return normalized;

  const trimmed = normalized.slice(0, maxLength + 1);
  const boundary = trimmed.search(/\s+\S*$/);
  const excerpt = (boundary > maxLength * 0.6 ? trimmed.slice(0, boundary) : normalized.slice(0, maxLength)).trim();

  return `${excerpt.replace(/[\s.,;:!?-]+$/, '')}…`;
}

const placeholderHash = hashString(placeholderSeed);
const placeholderPalette = palette[placeholderHash % palette.length];
const placeholderStyle = [
  `--placeholder-bg: ${placeholderPalette[0]}`,
  `--placeholder-accent: ${placeholderPalette[1]}`,
  `--placeholder-soft: ${placeholderPalette[2]}`,
  `--placeholder-tilt: ${(placeholderHash % 24) - 12}deg`,
  `--placeholder-shift: ${placeholderHash % 48}px`,
].join('; ');
const placeholderLabel = labelFrom(item);
const hasDisplayImage = isAcceptableSourceImage(item.image);
const cardBody = truncateExcerpt(item.body);
---
<article class:list={["story-card", compact && "compact", variant]}>
  <a class:list={["image", !hasDisplayImage && "placeholder-art"]} href={item.url} target="_blank" rel="noopener noreferrer" style={!hasDisplayImage ? placeholderStyle : undefined} aria-label={hasDisplayImage ? undefined : `Open story: ${item.title}`}>
    {hasDisplayImage ? (
      <img src={item.image} alt="" loading="lazy" />
    ) : (
      <span class="placeholder-inner" aria-hidden="true">
        <span class="placeholder-kicker">Factory Signal</span>
        <span class="placeholder-mark">{placeholderLabel}</span>
        <span class="placeholder-topic">{item.topic || item.source || 'Manufacturing intelligence'}</span>
      </span>
    )}
  </a>
  <div>
    <p class="meta">{item.dateLabel ? `${item.dateLabel} · ` : ''}{item.source}{item.topic ? ` · ${item.topic}` : ''}{item.sectionTitle ? ` · ${item.sectionTitle}` : ''}{item.score ? ` · ${item.score}/5` : ''}</p>
    <h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
    {stats && <p class="stats">{stats}</p>}
    {cardBody && <p>{cardBody}</p>}
  </div>
</article>
