---
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---
<Base
  title="Page not found"
  description="The Factory Signal page you requested could not be found."
  pathname="/404/"
  noindex
>
  <main>
    <article class="article-body">
      <p class="meta">404</p>
      <h1>Page not found</h1>
      <p>The Factory Signal page you requested does not exist or may have moved.</p>
      <p><a href="/">Return to the Factory Signal homepage</a> or browse the latest manufacturing intelligence sections below.</p>
      <ul>
        <li><a href="/news/">News archive</a></li>
        <li><a href="/briefings/">Daily briefings</a></li>
        <li><a href="/articles/">Articles</a></li>
      </ul>
    </article>
  </main>
</Base>