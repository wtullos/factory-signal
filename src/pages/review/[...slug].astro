---
import Base from '../../layouts/Base.astro';
import { getDraftArticles, formatDate } from '../../lib/content.js';
import { getAmaContext, getAmaReviewBadgeLabel, getPersonalAdditionRecommendations, isRedditAmaDraft } from '../../lib/review-prompts.js';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { slug: undefined } }];
}

const drafts = getDraftArticles();
const shellCommand = (draft) => `node scripts/publish-draft.mjs ${draft.slug || draft.filename}`;
const hasDate = (value) => /^\d{4}-\d{2}-\d{2}/.test(String(value || ''));
---
<Base title="Draft review inbox" description="Private Factory Signal draft review inbox." pathname="/review/" noindex={true} bodyClass="review-backend">
  <a class="review-logout-button" href="/review/logout" data-review-logout>Logout</a>
  <main>
    <div class="section-heading">
      <div>
        <p class="meta">Private workflow · intended URL: https://robot.thefactorysignal.com/</p>
        <h1>Draft review inbox</h1>
      </div>
    </div>

    <nav class="review-tabs" aria-label="Robot backend sections">
      <a aria-current="page" href="/review/">Drafts</a>
      <a href="/review/takeaways/">Daily takeaways</a>
    </nav>

    <section class="panel review-warning">
      <h2>Review before publishing</h2>
      <p>
        This page reads Markdown files from <code>content/drafts/</code>. Drafts are not public articles, the page is marked
        <code>noindex</code>, and hosted access to <code>https://robot.thefactorysignal.com/</code> is protected at the Cloudflare edge. Do not rely on browser-side
        passwords or hidden-page JavaScript for security.
      </p>
    </section>

    {drafts.length === 0 ? (
      <section class="panel empty-state">
        <h2>No drafts found</h2>
        <p>Add generated Markdown drafts to <code>content/drafts/*.md</code>, then refresh this page.</p>
      </section>
    ) : (
      <div class="review-list">
        {drafts.map((draft) => {
          const personalPrompts = getPersonalAdditionRecommendations(draft);
          const amaContext = getAmaContext(draft);
          const isAmaDraft = isRedditAmaDraft(draft);
          const amaBadgeLabel = getAmaReviewBadgeLabel(draft);
          return (
          <article class:list={["panel", "draft-card", { "ama-draft-card": isAmaDraft }]} data-article-type={draft.articleType || undefined}>
            <header class="draft-header">
              <div>
                <p class="meta">{draft.status} · {draft.pubDate && hasDate(draft.pubDate) ? formatDate(draft.pubDate.slice(0, 10)) : draft.pubDate || 'No publish date'}</p>
                <h2>{draft.title}</h2>
              </div>
              <div class="draft-header-badges">
                {amaBadgeLabel && <span class="ama-badge">{amaBadgeLabel}</span>}
                <span class="draft-slug">{draft.slug}</span>
              </div>
            </header>

            <dl class="review-meta">
              <div><dt>Author</dt><dd>{draft.author}</dd></div>
              <div><dt>File</dt><dd><code>{draft.path}</code></dd></div>
              <div><dt>Updated</dt><dd>{draft.updatedAt || 'Unknown'}</dd></div>
            </dl>

            {draft.description && <p class="draft-description">{draft.description}</p>}

            {amaContext && (
              <section class="ama-context" aria-label="Reddit AMA source context">
                <h3>{amaContext.label}</h3>
                <p>{amaContext.summary}</p>
                {amaContext.sourceUrl && <p><strong>AMA source:</strong> <a href={amaContext.sourceUrl}>{amaContext.sourceUrl}</a></p>}
              </section>
            )}

            {draft.tags.length > 0 && (
              <div class="tag-row" aria-label="Tags">
                {draft.tags.map((tag) => <span>{tag}</span>)}
              </div>
            )}

            {draft.sourceUrls.length > 0 && (
              <section class="source-list">
                <h3>Sources</h3>
                <ul>
                  {draft.sourceUrls.map((url) => <li><a href={url}>{url}</a></li>)}
                </ul>
              </section>
            )}

            <section class="body-preview">
              <h3>Body preview</h3>
              <div set:html={draft.html} />
            </section>

            <section class="publish-command">
              <h3>Approve and publish</h3>
              <p>
                Send a signed publish request to the local/Hermes receiver. The receiver still performs the actual repo move,
                build, and deploy outside this static review page.
              </p>

              <section class="personal-additions" aria-labelledby={`personal-additions-${draft.slug || draft.filename}`} data-personal-additions data-draft-id={draft.slug || draft.filename} data-draft-title={draft.title}>
                <div class="personal-additions-heading">
                  <h4 id={`personal-additions-${draft.slug || draft.filename}`}>Draft edits and Wes review edits</h4>
                  <p>Edit the publish title, author, and full Markdown body here. Optional Wes-authored input is saved through the signed receiver and, on publish, cleaned up and blended into the article instead of pasted as labeled callouts.</p>
                  <ul class="personal-recommendations" aria-label="Recommended personal additions">
                    <li><strong>Opening:</strong> {personalPrompts.opening}</li>
                    <li><strong>Mid-article:</strong> {personalPrompts.middle}</li>
                    <li><strong>Closing:</strong> {personalPrompts.closing}</li>
                  </ul>
                </div>
                <div class="draft-edit-grid">
                  <label>
                    <span>Publish title</span>
                    <input type="text" value={draft.title} maxlength="220" data-draft-edit="title" />
                  </label>
                  <label>
                    <span>Author(s)</span>
                    <input type="text" value={draft.author} maxlength="320" data-draft-edit="author" />
                  </label>
                  <label>
                    <span>Full Markdown body</span>
                    <small>Edit Markdown, not rendered HTML. Frontmatter stays managed by the receiver.</small>
                    <textarea rows="24" data-draft-edit="body">{draft.body}</textarea>
                  </label>
                </div>
                <div class="personal-addition-grid">
                  <label>
                    <span>Opening note</span>
                    <small>{personalPrompts.opening}</small>
                    <textarea name="opening" rows="3" maxlength="1200" data-addition-field data-review-edit="opening" placeholder={personalPrompts.opening}></textarea>
                  </label>
                  <label>
                    <span>Mid-article note</span>
                    <small>{personalPrompts.middle}</small>
                    <textarea name="middle" rows="3" maxlength="1200" data-addition-field data-review-edit="middle" placeholder={personalPrompts.middle}></textarea>
                  </label>
                  <label>
                    <span>Closing note</span>
                    <small>{personalPrompts.closing}</small>
                    <textarea name="closing" rows="3" maxlength="1200" data-addition-field data-review-edit="closing" placeholder={personalPrompts.closing}></textarea>
                  </label>
                </div>
                <div class="review-draft-actions">
                  <button class="button secondary" type="button" data-save-review-draft>Save draft</button>
                  <p class="publish-status" data-save-review-status role="status" aria-live="polite">Saved review edits will load here automatically.</p>
                </div>
              </section>

              <div class="publish-actions" data-publish-actions>
                <form class="publish-form publish-now-form" method="post" action="/review/publish">
                  <input type="hidden" name="draft" value={draft.slug || draft.filename} />
                  <input type="hidden" name="title" value={draft.title} />
                  <input type="hidden" name="action" value="publish_now" />
                  <button class="button" type="submit">Publish now</button>
                </form>

                <form class="publish-form schedule-form" method="post" action="/review/publish">
                  <input type="hidden" name="draft" value={draft.slug || draft.filename} />
                  <input type="hidden" name="title" value={draft.title} />
                  <input type="hidden" name="action" value="schedule" />
                  <label>
                    Publish date/time
                    <input type="datetime-local" name="publishAt" required />
                  </label>
                  <button class="button secondary" type="submit">Schedule publish</button>
                </form>

                <p class="publish-status" data-publish-status role="status" aria-live="polite">No publish request sent yet.</p>
              </div>

              <details class="command-fallback">
                <summary>Manual fallback command</summary>
                <p>Copy this command if the webhook receiver is not connected yet.</p>
                <label>
                  Copyable helper command
                  <input readonly value={shellCommand(draft)} onfocus="this.select()" />
                </label>
              </details>
            </section>
          </article>
          );
        })}
      </div>
    )}
  </main>

  <script>
    const logoutButton = document.querySelector('[data-review-logout]');
    if (logoutButton instanceof HTMLAnchorElement) {
      logoutButton.href = window.location.hostname === 'robot.thefactorysignal.com' ? '/logout' : '/review/logout';
    }

    const publishForms = document.querySelectorAll('[data-publish-actions] form');

    const collectReviewEdits = (draftCard) => {
      const reviewEdits = { opening: '', middle: '', closing: '' };
      draftCard?.querySelectorAll('[data-review-edit]').forEach((field) => {
        if (field instanceof HTMLTextAreaElement) {
          const key = field.dataset.reviewEdit;
          if (key && Object.prototype.hasOwnProperty.call(reviewEdits, key)) reviewEdits[key] = field.value;
        }
      });
      return reviewEdits;
    };

    const collectDraftEdits = (draftCard) => {
      const draftEdits = { title: '', author: '', body: '' };
      draftCard?.querySelectorAll('[data-draft-edit]').forEach((field) => {
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
          const key = field.dataset.draftEdit;
          if (key && Object.prototype.hasOwnProperty.call(draftEdits, key)) draftEdits[key] = field.value;
        }
      });
      return draftEdits;
    };

    const applyReviewEdits = (draftCard, reviewEdits = {}) => {
      draftCard?.querySelectorAll('[data-review-edit]').forEach((field) => {
        if (field instanceof HTMLTextAreaElement) {
          const key = field.dataset.reviewEdit;
          if (key && typeof reviewEdits[key] === 'string') field.value = reviewEdits[key];
        }
      });
    };

    const applyDraftEdits = (draftCard, draftEdits = {}) => {
      draftCard?.querySelectorAll('[data-draft-edit]').forEach((field) => {
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
          const key = field.dataset.draftEdit;
          if (key && typeof draftEdits[key] === 'string') field.value = draftEdits[key];
        }
      });
    };

    const setSaveStatus = (section, message, state = '') => {
      const status = section?.querySelector('[data-save-review-status]');
      if (status) {
        status.textContent = message;
        status.dataset.state = state;
      }
    };

    const reviewSections = document.querySelectorAll('[data-personal-additions][data-draft-id]');
    reviewSections.forEach((section) => {
      const draft = section.dataset.draftId || '';
      const title = section.dataset.draftTitle || '';
      const draftCard = section.closest('.draft-card');
      const saveButton = section.querySelector('[data-save-review-draft]');

      const loadReviewDraft = async () => {
        try {
          const url = new URL('/review/save', window.location.href);
          url.searchParams.set('draft', draft);
          const response = await fetch(url.href, { headers: { Accept: 'application/json' } });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok) throw new Error(result.message || `Review draft load failed with HTTP ${response.status}.`);
          if (result.reviewEdits) applyReviewEdits(draftCard, result.reviewEdits);
          if (result.draftEdits) applyDraftEdits(draftCard, result.draftEdits);
          setSaveStatus(section, result.savedAt ? `Loaded saved edits from ${new Date(result.savedAt).toLocaleString()}.` : 'No saved review edits yet.', 'success');
        } catch (error) {
          setSaveStatus(section, error instanceof Error ? error.message : 'Review draft load failed.', 'error');
        }
      };

      const saveReviewDraft = async () => {
        if (!(saveButton instanceof HTMLButtonElement)) return;
        const originalText = saveButton.textContent || '';
        saveButton.disabled = true;
        saveButton.textContent = 'Saving…';
        setSaveStatus(section, 'Saving review draft…', 'pending');
        try {
          const response = await fetch(new URL('/review/save', window.location.href).href, {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save', draft, title, draftEdits: collectDraftEdits(draftCard), reviewEdits: collectReviewEdits(draftCard) }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok) throw new Error(result.message || `Review draft save failed with HTTP ${response.status}.`);
          setSaveStatus(section, `${result.message || 'Review draft saved.'}${result.savedAt ? ` ${new Date(result.savedAt).toLocaleString()}` : ''}`, 'success');
        } catch (error) {
          setSaveStatus(section, error instanceof Error ? error.message : 'Review draft save failed.', 'error');
        } finally {
          saveButton.disabled = false;
          saveButton.textContent = originalText;
        }
      };

      if (saveButton instanceof HTMLButtonElement) saveButton.addEventListener('click', saveReviewDraft);
      loadReviewDraft();
    });

    publishForms.forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const container = form.closest('[data-publish-actions]');
        const status = container?.querySelector('[data-publish-status]');
        const submitButton = form.querySelector('button[type="submit"]');
        const originalButtonText = submitButton?.textContent || '';

        if (status) {
          status.textContent = 'Sending publish request…';
          status.dataset.state = 'pending';
        }
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Sending…';
        }

        try {
          const actionPath = form.getAttribute('action') || '';
          const publishEndpoint = new URL(actionPath, window.location.href).href;
          const formData = new FormData(form);
          const draftCard = form.closest('.draft-card');
          const draftEdits = collectDraftEdits(draftCard);
          const reviewEdits = collectReviewEdits(draftCard);
          Object.entries(draftEdits).forEach(([key, value]) => formData.set(`draftEdits.${key}`, value));
          if (draftEdits.title) formData.set('title', draftEdits.title);
          Object.entries(reviewEdits).forEach(([key, value]) => formData.set(`reviewEdits.${key}`, value));
          // Compatibility for older receiver/function deployments.
          formData.set('additionOpening', reviewEdits.opening);
          formData.set('additionMiddle', reviewEdits.middle);
          formData.set('additionClosing', reviewEdits.closing);

          const response = await fetch(publishEndpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const result = await response.json().catch(() => ({}));

          if (!response.ok || !result.ok) {
            throw new Error(result.message || `Publish request failed with HTTP ${response.status}.`);
          }

          if (status) {
            status.textContent = `${result.message || 'Publish request sent.'} Idempotency key: ${result.idempotencyKey || 'n/a'}`;
            status.dataset.state = 'success';
          }
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : 'Publish request failed.';
            status.dataset.state = 'error';
          }
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText;
          }
        }
      });
    });
  </script>
</Base>
