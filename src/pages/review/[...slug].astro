---
import Base from '../../layouts/Base.astro';
import { getDraftArticles, formatDate } from '../../lib/content.js';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { slug: undefined } }];
}

const drafts = getDraftArticles();
const shellCommand = (draft) => `node scripts/publish-draft.mjs ${draft.slug || draft.filename}`;
const hasDate = (value) => /^\d{4}-\d{2}-\d{2}/.test(String(value || ''));
---
<Base title="Draft review inbox" description="Private Factory Signal draft review inbox." pathname="/review/" noindex={true} bodyClass="review-backend">
  <a class="review-logout-button" href="/review/logout" data-review-logout>Logout</a>
  <main>
    <div class="section-heading">
      <div>
        <p class="meta">Private workflow · intended URL: https://robot.thefactorysignal.com/</p>
        <h1>Draft review inbox</h1>
      </div>
    </div>

    <section class="panel review-warning">
      <h2>Review before publishing</h2>
      <p>
        This page reads Markdown files from <code>content/drafts/</code>. Drafts are not public articles, the page is marked
        <code>noindex</code>, and hosted access to <code>https://robot.thefactorysignal.com/</code> is protected at the Cloudflare edge. Do not rely on browser-side
        passwords or hidden-page JavaScript for security.
      </p>
    </section>

    {drafts.length === 0 ? (
      <section class="panel empty-state">
        <h2>No drafts found</h2>
        <p>Add generated Markdown drafts to <code>content/drafts/*.md</code>, then refresh this page.</p>
      </section>
    ) : (
      <div class="review-list">
        {drafts.map((draft) => (
          <article class="panel draft-card">
            <header class="draft-header">
              <div>
                <p class="meta">{draft.status} · {draft.pubDate && hasDate(draft.pubDate) ? formatDate(draft.pubDate.slice(0, 10)) : draft.pubDate || 'No publish date'}</p>
                <h2>{draft.title}</h2>
              </div>
              <span class="draft-slug">{draft.slug}</span>
            </header>

            <dl class="review-meta">
              <div><dt>Author</dt><dd>{draft.author}</dd></div>
              <div><dt>File</dt><dd><code>{draft.path}</code></dd></div>
              <div><dt>Updated</dt><dd>{draft.updatedAt || 'Unknown'}</dd></div>
            </dl>

            {draft.description && <p class="draft-description">{draft.description}</p>}

            {draft.tags.length > 0 && (
              <div class="tag-row" aria-label="Tags">
                {draft.tags.map((tag) => <span>{tag}</span>)}
              </div>
            )}

            {draft.sourceUrls.length > 0 && (
              <section class="source-list">
                <h3>Sources</h3>
                <ul>
                  {draft.sourceUrls.map((url) => <li><a href={url}>{url}</a></li>)}
                </ul>
              </section>
            )}

            <section class="body-preview">
              <h3>Body preview</h3>
              <div set:html={draft.html} />
            </section>

            <section class="publish-command">
              <h3>Approve and publish</h3>
              <p>
                Send a signed publish request to the local/Hermes receiver. The receiver still performs the actual repo move,
                build, and deploy outside this static review page.
              </p>

              <section class="personal-additions" aria-labelledby={`personal-additions-${draft.slug || draft.filename}`} data-personal-additions>
                <div class="personal-additions-heading">
                  <h4 id={`personal-additions-${draft.slug || draft.filename}`}>Personal additions</h4>
                  <p>Add optional Wes-authored notes. These are inserted as editorial callouts when the draft is published.</p>
                </div>
                <div class="personal-addition-grid">
                  <label>
                    <span>Opening note</span>
                    <small>Why this one matters right now.</small>
                    <textarea name="additionOpening" rows="3" maxlength="1200" data-addition-field placeholder="Example: What caught my eye here is…"></textarea>
                  </label>
                  <label>
                    <span>Mid-article note</span>
                    <small>A practical shop-floor angle or operator takeaway.</small>
                    <textarea name="additionMiddle" rows="3" maxlength="1200" data-addition-field placeholder="Example: On the floor, I’d watch for…"></textarea>
                  </label>
                  <label>
                    <span>Closing note</span>
                    <small>A short final takeaway, caution, or next step.</small>
                    <textarea name="additionClosing" rows="3" maxlength="1200" data-addition-field placeholder="Example: Bottom line for manufacturers…"></textarea>
                  </label>
                </div>
              </section>

              <div class="publish-actions" data-publish-actions>
                <form class="publish-form publish-now-form" method="post" action="/review/publish">
                  <input type="hidden" name="draft" value={draft.slug || draft.filename} />
                  <input type="hidden" name="title" value={draft.title} />
                  <input type="hidden" name="action" value="publish_now" />
                  <button class="button" type="submit">Publish now</button>
                </form>

                <form class="publish-form schedule-form" method="post" action="/review/publish">
                  <input type="hidden" name="draft" value={draft.slug || draft.filename} />
                  <input type="hidden" name="title" value={draft.title} />
                  <input type="hidden" name="action" value="schedule" />
                  <label>
                    Publish date/time
                    <input type="datetime-local" name="publishAt" required />
                  </label>
                  <button class="button secondary" type="submit">Schedule publish</button>
                </form>

                <p class="publish-status" data-publish-status role="status" aria-live="polite">No publish request sent yet.</p>
              </div>

              <details class="command-fallback">
                <summary>Manual fallback command</summary>
                <p>Copy this command if the webhook receiver is not connected yet.</p>
                <label>
                  Copyable helper command
                  <input readonly value={shellCommand(draft)} onfocus="this.select()" />
                </label>
              </details>
            </section>
          </article>
        ))}
      </div>
    )}
  </main>

  <script>
    const logoutButton = document.querySelector('[data-review-logout]');
    if (logoutButton instanceof HTMLAnchorElement) {
      logoutButton.href = window.location.hostname === 'robot.thefactorysignal.com' ? '/logout' : '/review/logout';
    }

    const publishForms = document.querySelectorAll('[data-publish-actions] form');

    publishForms.forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const container = form.closest('[data-publish-actions]');
        const status = container?.querySelector('[data-publish-status]');
        const submitButton = form.querySelector('button[type="submit"]');
        const originalButtonText = submitButton?.textContent || '';

        if (status) {
          status.textContent = 'Sending publish request…';
          status.dataset.state = 'pending';
        }
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Sending…';
        }

        try {
          const actionPath = form.getAttribute('action') || '';
          const publishEndpoint = new URL(actionPath, window.location.href).href;
          const formData = new FormData(form);
          const draftCard = form.closest('.draft-card');
          draftCard?.querySelectorAll('[data-addition-field]').forEach((field) => {
            if (field instanceof HTMLTextAreaElement && field.name) {
              formData.set(field.name, field.value);
            }
          });

          const response = await fetch(publishEndpoint, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const result = await response.json().catch(() => ({}));

          if (!response.ok || !result.ok) {
            throw new Error(result.message || `Publish request failed with HTTP ${response.status}.`);
          }

          if (status) {
            status.textContent = `${result.message || 'Publish request sent.'} Idempotency key: ${result.idempotencyKey || 'n/a'}`;
            status.dataset.state = 'success';
          }
        } catch (error) {
          if (status) {
            status.textContent = error instanceof Error ? error.message : 'Publish request failed.';
            status.dataset.state = 'error';
          }
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.textContent = originalButtonText;
          }
        }
      });
    });
  </script>
</Base>
