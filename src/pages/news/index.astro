---
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getNewsStories, getStoryArchive } from '../../lib/content.js';

const stories = getNewsStories();
const { groups } = getStoryArchive(stories);
---
<Base title="Manufacturing news archive" description="Manufacturing news and video items from Factory Signal briefings, with Reddit discussion split into its own trending page." pathname="/news/">
  <main>
    <section class="section-band archive-toolbar" aria-label="Archive filters">
      <p class="meta">Newest first · Reddit excluded · external story links open at the original source</p>
    </section>

    <div class="archive-list story-archive">
      {groups.map((group) => {
        const [lead, ...rest] = group.stories;
        const features = rest.slice(0, 2);
        const river = rest.slice(2);
        return (
          <section class="briefing-summary news-edition" id={group.date}>
            <div class="section-heading compact-heading">
              <div>
                <p class="meta">{group.dateLabel}</p>
                <h2>{group.stories.length} news items</h2>
              </div>
              <a href={`/briefings/${group.briefingSlug}/`}>Full briefing</a>
            </div>
            <div class="edition-layout">
              {lead && <StoryCard item={lead} variant="lead-card" />}
              {features.length > 0 && (
                <div class="feature-grid">
                  {features.map((item) => <StoryCard item={item} compact variant="secondary-card" />)}
                </div>
              )}
              {river.length > 0 && (
                <div class="news-river">
                  {river.map((item) => <StoryCard item={item} compact variant="river-card" />)}
                </div>
              )}
            </div>
          </section>
        );
      })}
    </div>
  </main>
</Base>
