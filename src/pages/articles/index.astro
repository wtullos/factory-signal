---
import Base from '../../layouts/Base.astro';
import { getArticles, getPinnedArticles } from '../../lib/content.js';
const articles = getArticles();
const pinnedArticles = getPinnedArticles(articles);
---
<Base title="Original articles" description="Factory Signal original articles on manufacturing technology, automation, and industrial AI." pathname="/articles/">
  <main>
    <div class="section-heading"><h1>Original articles</h1></div>
    {pinnedArticles.length > 0 && (
      <section class="pinned-articles article-pinned-list" aria-label="Pinned articles">
        <p class="meta">Pinned for 24 hours after publishing</p>
        <div class="pinned-article-grid">
          {pinnedArticles.map((article) => <article class="pinned-article-card"><p class="meta">{article.pubDate} · pinned until {article.pinnedUntil}</p><h2><a href={`/articles/${article.slug}/`}>{article.title}</a></h2><p>{article.description}</p></article>)}
        </div>
      </section>
    )}
    <div class="article-list">
      {articles.map((article) => <article class="panel"><p class="meta">{article.pubDate} · {article.author}</p><h2><a href={`/articles/${article.slug}/`}>{article.title}</a></h2><p>{article.description}</p></article>)}
    </div>
  </main>
</Base>
