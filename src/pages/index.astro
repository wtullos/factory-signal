---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import BriefingSummary from '../components/BriefingSummary.astro';
import StoryCard from '../components/StoryCard.astro';
import { getBriefings, getArticles, getNewsStories, getRedditStories, SITE_NAME, TAGLINE } from '../lib/content.js';
const briefings = getBriefings();
const articles = getArticles();
const stories = getNewsStories();
const redditStories = getRedditStories();
const latest = briefings[0];
---
<Base title={SITE_NAME} description={TAGLINE} pathname="/">
  <main>
    <section class="hero">
      <div>
        <p class="meta">Daily industrial intelligence</p>
        <h1>Signal over noise for the future of manufacturing.</h1>
        <p class="lede">Factory Signal tracks advanced manufacturing, CNC, robotics, 3D printing, AI vision, and shop-floor automation so builders can scan what matters quickly.</p>
        <div class="signal-strip" aria-label="Coverage areas">
          <span>CNC</span>
          <span>Robotics</span>
          <span>Vision AI</span>
          <span>Additive</span>
        </div>
        <div class="button-row">
          <a class="button" href={latest ? `/briefings/${latest.slug}/` : '/briefings/'}>Read latest briefing</a>
          <a class="button secondary" href="/news/">Browse news archive</a>
        </div>
      </div>
      <aside class="panel">
        <p class="meta">Positioning</p>
        <h2>Daily intelligence for the future of manufacturing.</h2>
        <p>Automated briefings today; original analysis, buyer guides, interviews, and monetizable editorial tomorrow.</p>
        <ul class="feature-list">
          <li>Shop-floor automation trends</li>
          <li>Machine-tool and additive signals</li>
          <li>Industrial AI and robotics coverage</li>
        </ul>
      </aside>
    </section>
    <AdSlot slot="leaderboard" />
    <section class="section-band">
      <div class="section-heading"><h2>Manufacturing news</h2><a href="/news/">All {stories.length} non-Reddit stories</a></div>
      <p class="lede">The briefing backlog is now browsable as a newspaper-style feed of articles and videos, newest first. Community posts have moved to Reddit trends.</p>
      <div class="home-news-layout featured-story-grid">
        {stories[0] && <StoryCard item={stories[0]} variant="lead-card" />}
        <div class="feature-grid">
          {stories.slice(1, 5).map((item) => <StoryCard item={item} compact variant="secondary-card" />)}
        </div>
        <div class="news-river">
          {stories.slice(5, 11).map((item) => <StoryCard item={item} compact variant="river-card" />)}
        </div>
      </div>
    </section>
    <section class="section-band reddit-band">
      <div class="section-heading"><h2>Reddit trending</h2><a href="/reddit/">All {redditStories.length} posts</a></div>
      <p class="lede">What manufacturing communities are talking about, kept separate from the normal news archive.</p>
      <div class="reddit-mosaic compact-mosaic">
        {redditStories.slice(0, 4).map((item, index) => <StoryCard item={item} compact variant={index === 0 ? 'secondary-card reddit-lead' : 'river-card reddit-row'} />)}
      </div>
    </section>
    {latest && <section class="section-band"><div class="section-heading"><h2>Latest briefing</h2><a href="/briefings/">Archive</a></div><BriefingSummary briefing={latest} /></section>}
    <section class="section-band">
      <div class="section-heading"><h2>Original articles</h2><a href="/articles/">All articles</a></div>
      <div class="article-list">
        {articles.slice(0, 3).map((article) => <article class="panel"><p class="meta">{article.pubDate}</p><h3><a href={`/articles/${article.slug}/`}>{article.title}</a></h3><p>{article.description}</p></article>)}
      </div>
    </section>
  </main>
</Base>
