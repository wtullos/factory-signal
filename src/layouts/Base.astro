---
import '../styles/global.css';
import { SITE_NAME, TAGLINE, CONTACT_EMAIL, ADSENSE_ENABLED, ADSENSE_PUBLISHER_ID, canonical } from '../lib/content.js';

const {
  title = SITE_NAME,
  description = TAGLINE,
  pathname = Astro.url.pathname,
  type = 'website',
  noindex = false,
  bodyClass = '',
} = Astro.props;
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
const url = canonical(pathname);
const logoPath = '/assets/factory-signal-logo.jpg';
const normalizedPathForSearch = pathname.endsWith('/') ? pathname : `${pathname}/`;
const showNavSearch = normalizedPathForSearch === '/dashboard/' || normalizedPathForSearch === '/testpage/';
const isPrivatePath = pathname === '/review' || pathname.startsWith('/review/') || pathname === '/admin' || pathname.startsWith('/admin/');
const normalizedPathname = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
const noAdsPathnames = new Set([
  '/404',
  '/about',
  '/contact',
  '/cookie-policy',
  '/cookies',
  '/disclosure',
  '/display',
  '/privacy',
  '/search',
  '/terms',
  '/testpage',
]);
const isNoAdsPath = noAdsPathnames.has(normalizedPathname) || normalizedPathname.startsWith('/search/');
const showAdsenseVerification = ADSENSE_ENABLED && !noindex && !isPrivatePath && !isNoAdsPath;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={canonical(logoPath)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#39a935" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />
    {showAdsenseVerification && <meta name="google-adsense-account" content={ADSENSE_PUBLISHER_ID} />}
    {showAdsenseVerification && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`} crossorigin="anonymous"></script>}
    {!noindex && (
      <script is:inline>
        (() => {
          const endpoint = '/analytics/collect';
          const send = (payload) => {
            if (navigator.doNotTrack === '1' || window.doNotTrack === '1') return;
            const body = JSON.stringify({
              ...payload,
              path: window.location.pathname,
              title: document.title,
              timestamp: new Date().toISOString(),
            });
            if (navigator.sendBeacon) {
              const blob = new Blob([body], { type: 'application/json' });
              navigator.sendBeacon(endpoint, blob);
              return;
            }
            fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body,
              keepalive: true,
              credentials: 'omit',
            }).catch(() => {});
          };

          const clickLabel = (element) => (
            element.getAttribute('aria-label')
            || element.getAttribute('title')
            || element.textContent
            || ''
          ).replace(/\s+/g, ' ').trim().slice(0, 140);

          if (document.visibilityState !== 'prerender') {
            send({ type: 'pageview' });
          }

          document.addEventListener('click', (event) => {
            const link = event.target?.closest?.('a[href], button');
            if (!link) return;
            send({
              type: 'click',
              href: link instanceof HTMLAnchorElement ? link.href : '',
              text: clickLabel(link),
            });
          }, { capture: true, passive: true });
        })();
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <nav class="display-count-overlay" aria-label="Factory Signal sections">
      <a href="/">Home</a>
      <a href="/dashboard/">Dashboard</a>
      <a href="/news/">News</a>
      <a href="/reddit/">Community</a>
      <a href="/briefings/">Video</a>
      <a href="/articles/">Articles</a>
      <a href="/dashboard/#whitepaper-library">Papers</a>
      {showNavSearch && (
        <div class="site-search-nav" data-fs-search-nav>
          <button class="site-search-toggle" type="button" aria-label="Open site search" aria-expanded="false" aria-controls="site-search-dropdown" data-fs-search-toggle>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" focusable="false">
              <path d="M10.75 4a6.75 6.75 0 0 1 5.36 10.86l3.52 3.51-1.41 1.41-3.51-3.52A6.75 6.75 0 1 1 10.75 4Zm0 2a4.75 4.75 0 1 0 0 9.5 4.75 4.75 0 0 0 0-9.5Z" fill="currentColor"></path>
            </svg>
          </button>
          <div id="site-search-dropdown" class="site-search-dropdown" hidden data-fs-search-dropdown>
            <label class="site-search-label" for="site-search-input">Search the main page</label>
            <div class="site-search-row">
              <input id="site-search-input" class="site-search-input" type="search" placeholder="Search stories, articles, and resources" autocomplete="off" data-fs-search-input />
              <button class="site-search-clear" type="button" data-fs-search-clear>Clear</button>
            </div>
            <p class="site-search-status" aria-live="polite" data-fs-search-status>Showing all Factory Signal items.</p>
            <p class="site-search-empty" data-fs-search-empty hidden>No matching stories, articles, or resources found. Try a different topic or source.</p>
          </div>
        </div>
      )}
    </nav>
    <div class="shell">
      <header class="site-header">
        <div class="header-grid">
          <a class="brand-lockup" href="/" aria-label={`${SITE_NAME} home`}>
            <img class="brand-logo" src={logoPath} alt="Factory Signal logo" width="1254" height="1254" />
            <span class="brand-copy">
              <span class="eyebrow">Advanced Manufacturing · CNC · Robotics · 3D Printing · AI Vision</span>
              <span class="brand">{SITE_NAME}</span>
              <span class="tagline">{TAGLINE}</span>
            </span>
          </a>
        </div>
      </header>
      <slot />
      <footer class="site-footer">
        <p>{SITE_NAME} publishes automated manufacturing briefings and original editorial notes.</p>
        <p><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/privacy/">Privacy</a> · <a href="/cookie-policy/">Cookies</a> · <a href="/terms/">Terms</a> · <a href="/disclosure/">Disclosure</a></p>
        <p>Questions: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        <p>© 2026 {SITE_NAME}</p>
      </footer>
    </div>
  </body>
</html>
