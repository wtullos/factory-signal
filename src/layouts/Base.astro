---
import '../styles/global.css';
import { SITE_NAME, TAGLINE, CONTACT_EMAIL, ADSENSE_ENABLED, ADSENSE_PUBLISHER_ID, canonical } from '../lib/content.js';

const {
  title = SITE_NAME,
  description = TAGLINE,
  pathname = Astro.url.pathname,
  type = 'website',
} = Astro.props;
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
const url = canonical(pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS`} href="/rss.xml" />
    {ADSENSE_ENABLED && <meta name="google-adsense-account" content={ADSENSE_PUBLISHER_ID} />}
    {ADSENSE_ENABLED && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUBLISHER_ID}`} crossorigin="anonymous"></script>}
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="eyebrow">Advanced Manufacturing · CNC · Robotics · 3D Printing · AI Vision</div>
        <a class="brand" href="/">{SITE_NAME}</a>
        <p>{TAGLINE}</p>
        <nav>
          <a href="/">Home</a>
          <a href="/briefings/">Briefings</a>
          <a href="/articles/">Articles</a>
          <a href="/about/">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>{SITE_NAME} publishes automated manufacturing briefings and original editorial notes.</p>
        <p><a href="/about/">About</a> · <a href="/privacy/">Privacy</a> · <a href="/disclosure/">Disclosure</a> · <a href={`mailto:${CONTACT_EMAIL}`}>Contact</a></p>
        <p>© 2026 {SITE_NAME}</p>
      </footer>
    </div>
  </body>
</html>
