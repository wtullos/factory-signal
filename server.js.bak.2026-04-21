    display: flex;
    gap: 0;
    padding: 8px 0;
  }
  
  .date-btn {
    padding: 5px 14px;
    font-size: 11px;
    font-family: 'Libre Baskerville', serif;
    background: none;
    border: 1px solid #ddd;
    cursor: pointer;
    color: #333;
    margin-right: 5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
