    font-size: 72px;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1;
    color: #121212;
    margin-bottom: 2px;
  }
  
  .masthead-tagline {
    font-size: 12px;
    color: #666;
    font-style: italic;
    margin-top: 0;
    font-family: 'Libre Baskerville', serif;
    letter-spacing: 0.3px;
  }
  
  .masthead-bottom {
    display: flex;
    align-items: center;
    padding: 0 20px;
    border-bottom: 1px solid #e2e2e2;
    overflow-x: auto;
  }
  
