{
  "name": "factory-signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Factory Signal static publication for manufacturing intelligence.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 8888",
    "preview": "astro preview --host 0.0.0.0 --port 8888",
    "generate:fallback-images": "node scripts/generate-fallback-images.mjs",
    "generate:daily-briefing": "node scripts/generate-daily-briefing.mjs",
    "generate:reddit-ama-draft": "node scripts/generate-reddit-ama-draft.mjs",
    "build": "npm run generate:fallback-images && astro build",
    "sync:briefings": "node scripts/sync-briefings.mjs",
    "review:publish-receiver": "node scripts/review-publish-receiver.mjs",
    "style:guard": "node scripts/style-guard.mjs",
    "test:review-publish-receiver": "node --test test/review-publish-receiver.test.mjs",
    "test:content": "node --test test/content.test.mjs",
    "test:school-friendly": "node --test test/school-friendly.test.mjs",
    "test:style-guard": "node --test test/style-guard.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.1",
    "marked": "^16.4.1"
  }
}
